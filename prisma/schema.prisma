generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("USER")
  preferredLang String   @default("ar")
  xrplAddress   String?
  avatarUrl     String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products      Product[]
  orders        Order[]
  subscriptions Subscription[]
  clientJobs    EscrowJob[]       @relation("ClientEscrow")
  providerJobs  EscrowJob[]       @relation("ProviderEscrow")
  reviews       Review[]
  notifications Notification[]
  aiGenerations AiGenerationLog[]
  payments      Payment[]
  usageCounters AiUsageCounter[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleAr       String?
  titleEn       String?
  description   String
  descriptionAr String?
  descriptionEn String?
  content       String   @db.Text
  contentType   String   @default("markdown")
  productType   String
  qualityTier   String   @default("standard")
  priceXrp      Decimal  @db.Decimal(20, 8)
  priceUsd      Decimal? @db.Decimal(20, 8)
  category      String
  tags          String?
  language      String   @default("ar")
  isActive      Boolean  @default(true)
  isAiGenerated Boolean  @default(true)
  downloadCount Int      @default(0)
  viewCount     Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  coverImage    String?
  fileUrl       String?
  metadata      String?
  creatorId     String?
  creator       User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders  OrderItem[]
  reviews Review[]

  @@index([isActive, createdAt])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          String   @default("PENDING")
  totalXrp        Decimal  @db.Decimal(20, 8)
  totalUsd        Decimal? @db.Decimal(20, 8)
  paymentProvider String   @default("xrp")
  paymentId       String?
  destinationTag  Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)
  priceXrp  Decimal  @db.Decimal(20, 8)
  priceUsd  Decimal? @db.Decimal(20, 8)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planId          String?
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider        String
  externalId      String?       @unique
  transactionHash String?       @unique
  amount          Decimal       @db.Decimal(20, 8)
  currency        String        @default("XRP")
  status          String        @default("PENDING")
  destinationTag  Int?
  rawData         String?       @db.Text
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status])
  @@index([orderId, status])
  @@index([planId, status])
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  status                 String   @default("ACTIVE")
  currentPeriodStart     DateTime @default(now())
  currentPeriodEnd       DateTime
  paymentProvider        String   @default("xrp")
  providerSubscriptionId String?  @unique
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  payments Payment[]

  @@index([userId, status, currentPeriodEnd])
}

model EscrowJob {
  id                 String    @id @default(cuid())
  title              String
  description        String    @db.Text
  amountXrp          Decimal   @db.Decimal(20, 8)
  amountUsd          Decimal?  @db.Decimal(20, 8)
  status             String    @default("OPEN")
  category           String    @default("development")
  clientId           String
  client             User      @relation("ClientEscrow", fields: [clientId], references: [id], onDelete: Restrict)
  providerId         String?
  provider           User?     @relation("ProviderEscrow", fields: [providerId], references: [id], onDelete: SetNull)
  escrowTxHash       String?
  escrowSequence     Int?
  condition          String?
  fulfillment        String?
  finishAfter        DateTime?
  cancelAfter        DateTime?
  ownerAddress       String?
  destinationAddress String?
  deliveryNotes      String?
  clientRating       Int?
  providerRating     Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model AiGenerationLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt       String   @db.Text
  productType  String
  qualityTier  String
  language     String   @default("ar")
  result       String   @db.Text
  productId    String?
  tokensUsed   Int?
  status       String   @default("SUCCESS")
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AiUsageCounter {
  id            String @id @default(cuid())
  userId        String
  period        String
  aiGenerations Int    @default(0)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([period])
}
