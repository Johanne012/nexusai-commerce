# ======================
# Required for Vercel build & runtime
# ======================

# SQLite for demo / Postgres for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/nexusai?sslmode=require"

# NextAuth (REQUIRED on Vercel)
NEXTAUTH_URL="https://nexusai-commerce.vercel.app"
NEXTAUTH_SECRET="replace-with-long-random-string-min-32-chars"

# XRPL receiving address
PLATFORM_XRPL_ADDRESS="rYourXrplAddressHere"
XRPSCAN_API_URL="https://api.xrpscan.com/api/v1"

# Optional
OPENAI_API_KEY=""
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
