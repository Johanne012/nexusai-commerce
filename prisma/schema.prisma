// NexusAI Commerce - Expanded Professional Schema
// Multi-language, Multi-provider, Real Escrow support, AI product types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  role            String    @default("USER")
  preferredLang   String    @default("ar")
  xrplAddress     String?
  avatarUrl       String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products        Product[]
  orders          Order[]
  subscriptions   Subscription[]
  clientJobs      EscrowJob[] @relation("ClientEscrow")
  providerJobs    EscrowJob[] @relation("ProviderEscrow")
  reviews         Review[]
  notifications   Notification[]
  aiGenerations   AiGenerationLog[]
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleAr         String?
  titleEn         String?
  description     String
  descriptionAr   String?
  descriptionEn   String?
  content         String
  contentType     String   @default("markdown")
  productType     String
  qualityTier     String   @default("standard")
  priceXrp        Float
  priceUsd        Float?
  category        String
  tags            String?
  language        String   @default("ar")
  isActive        Boolean  @default(true)
  isAiGenerated   Boolean  @default(true)
  downloadCount   Int      @default(0)
  viewCount       Int      @default(0)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  coverImage      String?
  fileUrl         String?
  metadata        String?
  creatorId       String?
  creator         User?    @relation(fields: [creatorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          OrderItem[]
  reviews         Review[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING")
  totalXrp        Float
  totalUsd        Float?
  paymentProvider String   @default("xrp")
  paymentId       String?
  destinationTag  Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int     @default(1)
  priceXrp    Float
  priceUsd    Float?
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  provider        String
  externalId      String?
  amount          Float
  currency        String   @default("XRP")
  status          String   @default("PENDING")
  destinationTag  Int?
  rawData         String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  planId             String
  status             String   @default("ACTIVE")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  paymentProvider    String   @default("xrp")
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments           Payment[]
}

model EscrowJob {
  id                String   @id @default(cuid())
  title             String
  description       String
  amountXrp         Float
  amountUsd         Float?
  status            String   @default("OPEN")
  category          String   @default("development")
  clientId          String
  client            User     @relation("ClientEscrow", fields: [clientId], references: [id])
  providerId        String?
  provider          User?    @relation("ProviderEscrow", fields: [providerId], references: [id])
  escrowTxHash      String?
  escrowSequence    Int?
  condition         String?
  fulfillment       String?
  finishAfter       DateTime?
  cancelAfter       DateTime?
  ownerAddress      String?
  destinationAddress String?
  deliveryNotes     String?
  clientRating      Int?
  providerRating    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  body        String
  type        String   @default("info")
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

model AiGenerationLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  prompt        String
  productType   String
  qualityTier   String
  language      String   @default("ar")
  result        String
  productId     String?
  tokensUsed    Int?
  status        String   @default("SUCCESS")
  errorMessage  String?
  createdAt     DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}
