# PostgreSQL — use a managed database URL in deployment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexusai?schema=public&sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional AI provider
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Payment providers — Demo is local-development only
PAYMENT_PROVIDER="xrp"
PLATFORM_XRPL_ADDRESS=""
XRPSCAN_API_URL="https://api.xrpscan.com/api/v1"
XRP_USD_RATE="0.6"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional OAuth providers (Prisma adapter enabled)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
